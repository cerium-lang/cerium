/* std::sys -- the platform's own calls, each declared as the ABI
 * spells it: the C symbol unmangled, the arguments and the return
 * the platform's own types. Nothing here is cerium's -- the words
 * are the ABI's, the errors the platform's own -- and every other
 * door in the library reaches the platform through one of these.
 * write is the one door both halves of the library and panic
 * share. */

#[extern(C)]
pub fn write(fd: i32, buf: *u8, len: usize) -> isize;
