/* std::meta -- the reflection model (08-reflection.md).
 *
 * This is the language's own source, read from the sysroot as the
 * project's first files (12-projects.md): TypeInfo is ordinary
 * data -- stored, compared, matched -- and @typeinfo produces it.
 * The names live in std::meta, reached by its path or by a use;
 * every item is pub, the whole point of the namespace
 * (11-namespaces.md).
 *
 * A 'type' field holds a type reference: a value whose type is
 * 'type' and whose value is a type. Lazy on purpose -- a reference
 * names a type without inlining that type's TypeInfo, which is what
 * keeps a recursive struct's reflection finite. */

pub enum TypeInfo {
  Bool,
  Int      { bits: u16, signed: bool },
  Float    { bits: u16 },
  Pointer  { child: type, mutable: bool },   /* *T / *mut T */
  Slice    { child: type, mutable: bool },   /* []T / []mut T */
  Array    { len: usize, child: type, mutable: bool }, /* [N]T */
  Struct   { fields: []Field, attrs: []Attr },
  Union    { fields: []Field, attrs: []Attr },
  Enum     { tag: type, variants: []EnumField },
  Tuple    { fields: []Field },              /* () has none */
  Fn       { args: []FnArg, ret: type },     /* fn(A) -> R */
  Optional { child: type },                  /* ?T, the sugar */
  Result   { ok: type, err: type },          /* E?T, the sugar */
  Voidptr,                                   /* voidptr */
}

pub struct Field {
  name: []u8,
  type: type,   /* a type reference */
  offset: usize,
  mutable: bool,
  attrs: []Attr,
}

pub struct EnumField {
  name: []u8,
  value: i64,
  type: ?type,  /* None when the variant carries no payload */
  attrs: []Attr,
}

pub struct FnArg {
  name: []u8,   /* always empty -- a name lives in the declaration */
  type: type,
}

pub struct Attr {
  name: []u8,
  args: []AttrArg,
}

pub enum AttrArg {   /* an argument is a name, a number, a string, or
                      * a predicate's own words (12-projects.md) */
  Ident([]u8),   /* #[cfg(debug)] -- debug */
  Int(i64),      /* #[align(16)] -- 16 */
  Str([]u8),     /* a string literal */
  Nest { name: []u8, args: []AttrArg }, /* #[cfg(any(linux, darwin))]
                                         * -- any, its words */
}

/* is_same -- the type-equality predicate, a predicate struct: an
 * empty shape instantiated only by the types it compares, its
 * value an associated constant the impls carry -- the (T, T)
 * repeated-variable impl matching where both args land one type,
 * the (A, B) blanket behind it answering false (05-traits.md).
 * The instance takes no space; the read folds at compile time. */
pub struct is_same<A, B> {}

impl<A, B> is_same<A, B> {
  const value: bool = false;
}

impl<T> is_same<T, T> {
  const value: bool = true;
}
