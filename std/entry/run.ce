/* std::entry -- the door's own helpers, one per ending a main has
 * (12-projects.md). The compiler's wrapper picks the one the
 * project's main answers, hands it the main by address with the
 * platform's own two -- the count and the table of words -- and
 * every entry does the same three things: the two saved for sys's
 * own asking (args.ce, the iterator they walk), the main called,
 * the ending answered -- a unit a clean zero, an i32 the code
 * itself, an E?() handed to fmt's exit, the Err half printed
 * through its own words there. */

use std::fmt::{Fmt, exit};
use std::sys;

pub fn run_unit(m: fn() -> (), n: i32, v: **u8) -> i32 {
  sys::set_args(n, v);
  m();
  0
}

pub fn run_i32(m: fn() -> i32, n: i32, v: **u8) -> i32 {
  sys::set_args(n, v);
  m()
}

pub fn run_err<E: Fmt>(m: fn() -> E?(), n: i32, v: **u8) -> i32 {
  sys::set_args(n, v);
  exit(m())
}
