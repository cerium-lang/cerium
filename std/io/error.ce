/* std::io::Error -- a system call failed: the errno it set,
 * read from the platform's own thread-local word (std::sys).
 * The doors' own answer when the platform takes the bytes back
 * (stdout.ce, stderr.ce), and every sink's after them --
 * wherever bytes go, this is the error that names the
 * failure. Its own Fmt says it the plain way, the errno's
 * number beside the namespace's name, so a main that hands it
 * back prints something a reader can act on. */

use std::Result;
use std::fmt::{Fmt, Writer};

pub enum Error {
  Sys(i32), /* a system call failed: the errno it set, read from
             * the platform's own thread-local word (std::sys) */
}

impl Fmt for Error {
  fn fmt(self: *Self, w: *mut Writer) -> Result<(), Error> {
    match *self {
      Sys(n) => {
        w.write_str("io error ")?;
        w.write_i32(n)?;
        Ok(())
      },
    }
  }
}
