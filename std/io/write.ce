/* std::io::Write -- the sink's own contract: bytes in, the count
 * of them out, the errors the platform's word names (error.ce).
 * Whatever takes bytes implements it -- the process's own doors
 * beside it here (stdout.ce, stderr.ce), a sink of anyone's own
 * anywhere else -- and the prints that join a Fmt to them live
 * in std::fmt, the join drawn from that side so the arrow
 * between the two namespaces points one way. */

use std::Result;

pub trait Write {
  fn write(self: *mut Self, buf: []u8) -> Result<usize, Error>;
}
