/* std::io::Write -- the sink's own contract: bytes in, the count
 * of them out, the errors the platform's word names. Whatever
 * takes bytes implements it -- the process's two doors in this
 * namespace's other file, a sink of anyone's own anywhere else --
 * and every print joins a Fmt to one of them. */

use std::Result;

pub trait Write {
  fn write(self: *mut Self, buf: []u8) -> Result<usize, Error>;
}
