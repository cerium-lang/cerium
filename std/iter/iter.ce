/* std::iter -- the Iter family (10-iteration.md): two traits, the
 * sequence's own shape. Iter is the loop's own word -- the
 * associated type says what it yields, the one method advances and
 * yields it, None the sequence's end. IntoIter turns a container
 * into its iterator, consuming it; an iterator is its own IntoIter,
 * so the blanket row hands every Iter back.
 *
 * for-in rides both: the sugar spells c.into_iter() once, then
 * it.next() a round, the answer matched -- Some runs the body, None
 * ends the loop, exactly the desugar 10-iteration.md writes. What
 * the loop does not take destructs with the iterator itself at the
 * loop's exit, its fields the walk's own recursion (03-move.md).
 *
 * A slice is an Iter down here, its header the cursor -- the loop
 * over one rides the same desugar the rest do, the source's own
 * header untouched behind the copy the iterator walks (10).
 *
 * An owned array's ArrayIter waits on the one thing it needs: an
 * impl's own const length, [N]T routed through the impl table
 * (08-reflection.md). Until then an array iterates the compiler's
 * own special case, element by element (10). */
pub trait Iter {
  type Item;
  fn next(self: *mut Self) -> ?Self::Item;   /* None ends the sequence */
}

pub trait IntoIter {
  type Iter;
  fn into_iter(self: Self) -> Self::Iter;
}

impl<I: Iter> IntoIter for I {
  type Iter = I;
  fn into_iter(self: Self) -> I { self }
}

/* a slice is an iterator over its elements (10): the header is the
 * cursor. A slice views, never owns -- the header is a pair of
 * scalars, a copy of it as harmless as the view itself -- so
 * iterating lends each element out, a pointer a round, and what the
 * loop walked over stays whole behind it. The mutable row is the
 * more specific one: it wins for []mut T the same way *T wins over
 * T (04-generics.md). */
impl<T> Iter for []T {
  type Item = *T;
  fn next(self: *mut Self) -> ?*T {
    if self.len == 0 {
      None
    } else {
      let p = self.ptr;

      *self = (*self)[1..];
      Some(p)
    }
  }
}

impl<T> Iter for []mut T {
  type Item = *mut T;
  fn next(self: *mut Self) -> ?*mut T {
    if self.len == 0 {
      None
    } else {
      let p = self.ptr;

      *self = (*self)[1..];
      Some(p)
    }
  }
}

/* a mut borrow is an iterator over the thing it borrows (10): the
 * pointer forwards each round to the iterator beneath it, the state
 * that iterator holds. The loop over one -- for x in &mut c, the
 * borrower's own spelling -- rides the same desugar the values do,
 * the loop lending the sequence out instead of taking it. */
impl<T: Iter> Iter for *mut T {
  type Item = T::Item;
  fn next(self: *mut Self) -> ?T::Item {
    Iter::next(*self)   /* the borrowed iterator's own round, the
                         * pointer the value it takes */
  }
}
