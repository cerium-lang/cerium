/* std::fmt's prints -- the join of a Fmt to a door, one house
 * now: the doors and the words the same namespace (stdout.ce,
 * stderr.ce, the sink's contract write.ce beside), the join
 * crossing no line. fmt_to the general one, any sink; print and
 * eprint the string of words itself, a value where each hole
 * stands, the hole bare ({}) or carrying a spec -- a fill, an
 * alignment, a minimum width, a precision, a base
 * (12-projects.md); print_one and eprint_one the two
 * conveniences, one value, the process's own doors. The count
 * handed back is the whole print's own, however many writes it
 * took. */

use std::meta::TypeInfo;
use std::ops::Copy; /* the hole the pack's peel hands down: a copy
                     * each unfolding, the opt-in the use itself is
                     * (03-move.md, 12-projects.md) */

pub fn fmt_to<T: Fmt>(v: *T, w: dyn mut Write) -> Result<usize, Error> {
  let mut wr = Writer { w: w, prec: 0, base: 0 };

  v.fmt(&mut wr)?;
  wr.written()
}

pub fn print_one<T: Fmt>(v: *T) -> Result<usize, Error> {
  let mut out = Stdout { };

  fmt_to(v, &mut dyn out)
}

pub fn eprint_one<T: Fmt>(v: *T) -> Result<usize, Error> {
  let mut out = Stderr { };

  fmt_to(v, &mut dyn out)
}

/* the string of words, its own walk -- eight pieces, none pub:
 * shaped and holes the compiler's reads (the string is const,
 * the asking is the run, 08-reflection.md), lit the runtime walk
 * of a literal run, spec a hole's own words read where the walk
 * stops, Count, fills and pad the width a hole asks -- the value
 * measured by a walk that writes nowhere, the fill written
 * around it -- and runs the pack's own peel over the values
 * (04-generics.md). The reads carry no @compileError of their
 * own: a fn the evaluator has not run reports the words it holds
 * at its body's own walk, and std holds no call that runs these
 * ahead of it -- the doors live in the const ifs of the prints
 * themselves, where the branch taken is the only one walked. */

/* the format's shape, asked where the call is written: every {
 * opens one of the three it may -- a bare hole {}, a brace {{,
 * or a spec {:...} -- and the spec's own grammar is [fill]
 * [align] [width] [precision] [base]: a byte the alignment follows is
 * the fill (the two-char lookahead, {:x>8} the x a fill), < ^ >
 * the three alignments, the width a decimal run, the precision a
 * dot and the decimal run behind it, x o b a base letter, and
 * the '}' closes. }}
 * is one brace for two, a } alone the byte it is. The answer a
 * plain bool: the fn reads at compile time, and the words a bad
 * shape answers with are the print's own door */
fn shaped(const fmt: []u8) -> bool {
  let mut i: usize = 0;

  for i < fmt.len() {
    if fmt[i] == 123 { /* '{' */
      if i + 1 == fmt.len() {
        return false; /* the last { stands alone */
      }
      if fmt[i + 1] == 123 || fmt[i + 1] == 125 { /* '{{' or '{}' */
        i = i + 2;
      } else if fmt[i + 1] == 58 { /* '{:' -- the spec */
        i = i + 2;
        if i + 1 < fmt.len() && (fmt[i + 1] == 60 || fmt[i + 1] == 62 || fmt[i + 1] == 94) {
          i = i + 2; /* a fill, the alignment behind it */
        } else if i < fmt.len() && (fmt[i] == 60 || fmt[i] == 62 || fmt[i] == 94) {
          i = i + 1; /* the alignment alone */
        }
        for i < fmt.len() && fmt[i] >= 48 && fmt[i] <= 57 {
          i = i + 1; /* the width, a decimal run */
        }
        if i < fmt.len() && fmt[i] == 46 { /* '.': the precision, a decimal run behind it */
          i = i + 1;
          if i >= fmt.len() || fmt[i] < 48 || fmt[i] > 57 {
            return false; /* the dot names nothing */
          }
          for i < fmt.len() && fmt[i] >= 48 && fmt[i] <= 57 {
            i = i + 1;
          }
        }
        if i < fmt.len() && (fmt[i] == 120 || fmt[i] == 111 || fmt[i] == 98) {
          i = i + 1; /* x o b: the base -- the fill's x an alignment follows */
        }
        if i >= fmt.len() || fmt[i] != 125 {
          return false; /* the spec never closed, or holds what it should not */
        }
        i = i + 1;
      } else {
        return false; /* neither a hole, a brace, nor a spec */
      }
    } else {
      if fmt[i] == 125 && i + 1 < fmt.len() && fmt[i + 1] == 125 {
        i = i + 2; /* '}}': one brace for two */
      } else {
        i = i + 1; /* a '}' alone, and every other byte: itself */
      }
    }
  }
  true
}

/* the format's holes, counted the same walk's own way: each {
 * that does not open a brace a hole, the spec between its braces
 * skipped whole -- the shape already asked before this runs, the
 * count the ask */
fn holes(const fmt: []u8) -> usize {
  let mut n: usize = 0;
  let mut i: usize = 0;

  for i < fmt.len() {
    if fmt[i] == 123 && i + 1 < fmt.len() && fmt[i + 1] == 123 { /* '{{': the brace */
      i = i + 2;
    } else if fmt[i] == 123 { /* a hole, bare or spec'd -- the shape says the braces close */
      n = n + 1;
      i = i + 1; /* past the '{': the spec's own words, or the bare '}' itself */
      for i < fmt.len() && fmt[i] != 125 {
        i = i + 1;
      }
      i = i + 1; /* past the '}' */
    } else if fmt[i] == 125 && i + 1 < fmt.len() && fmt[i + 1] == 125 { /* '}}' */
      i = i + 2;
    } else {
      i = i + 1;
    }
  }
  n
}

/* the literal run before the next hole: every byte itself, the
 * two escapes folded to one, a '}' alone the byte it is. The
 * walk stops where an unescaped '{' stands -- the doors have said
 * a hole is due -- and answers the index it stopped at */
fn lit(w: *mut Writer, fmt: []u8, from: usize) -> Result<usize, Error> {
  let mut i = from;

  for i < fmt.len() {
    if fmt[i] == 123 { /* '{' */
      if i + 1 < fmt.len() && fmt[i + 1] == 123 {
        w.write_u8(123)?; /* '{{': the brace itself */
        i = i + 2;
      } else {
        break; /* the hole's opening */
      }
    } else if fmt[i] == 125 { /* '}' */
      w.write_u8(125)?;
      if i + 1 < fmt.len() && fmt[i + 1] == 125 {
        i = i + 2; /* '}}': one brace for two */
      } else {
        i = i + 1; /* alone: the byte it is */
      }
    } else {
      w.write_u8(fmt[i])?;
      i = i + 1;
    }
  }
  Ok(i)
}

/* a hole's own words, read where the walk stops: [fill] [align]
 * [width] [precision] [base] between the braces, the grammar
 * already asked and the bytes here honest */
struct Hole {
  mut fill: u8,     /* the space when the spec names none */
  mut align: u8,    /* 0: none -- the type's own answer then */
  mut width: usize, /* 0: none */
  mut prec: usize,  /* 0: none -- .0 the none the zero spells */
  mut base: u8,     /* 0: ten -- x o b the three others */
  mut end: usize,   /* the index past the hole's closing '}' */
}

impl Copy for Hole { } /* scalars every field: the row the pack's
                        * peel hands down, a copy each unfolding
                        * (03-move.md) */

fn spec(fmt: []u8, at: usize) -> Hole {
  let mut h = Hole { fill: 32, align: 0, width: 0, prec: 0, base: 0, end: 0 };
  let mut i = at + 1; /* past the '{' the walk stopped at */

  if fmt[i] == 58 { /* ':' -- the spec's own words */
    i = i + 1;
    if i + 1 < fmt.len() && (fmt[i + 1] == 60 || fmt[i + 1] == 62 || fmt[i + 1] == 94) {
      h.fill = fmt[i]; /* the fill, the alignment behind it */
      h.align = fmt[i + 1];
      i = i + 2;
    } else if fmt[i] == 60 || fmt[i] == 62 || fmt[i] == 94 {
      h.align = fmt[i]; /* the alignment alone */
      i = i + 1;
    }
    for i < fmt.len() && fmt[i] >= 48 && fmt[i] <= 57 {
      h.width = h.width * 10 + @cast<usize>(fmt[i] - 48); /* the width, decimal */
      i = i + 1;
    }
    if i < fmt.len() && fmt[i] == 46 { /* '.': the precision, the shape asked its run */
      i = i + 1;
      for i < fmt.len() && fmt[i] >= 48 && fmt[i] <= 57 {
        h.prec = h.prec * 10 + @cast<usize>(fmt[i] - 48);
        i = i + 1;
      }
    }
    if i < fmt.len() && (fmt[i] == 120 || fmt[i] == 111 || fmt[i] == 98) {
      h.base = fmt[i]; /* x o b: the base, the shape asked its letter */
      i = i + 1;
    }
  }
  h.end = i + 1; /* past the '}' the shape asked says stands */
  h
}

/* the counting sink: a Writer's walk that writes nowhere, the
 * length a value spells measured before the value spells it for
 * real -- the pad's first pass. std has no heap, and a buffer
 * would cap a str's own length; two walks the honest price */
struct Count {
  mut n: usize, /* the running count: every segment's bytes, kept as they land */
}

impl Write for Count {
  fn write(self: *mut Self, buf: []u8) -> Result<usize, Error> { /* the sink's
    * contract the walk's own (write.ce), the failure the door's
    * (error.ce) -- one house, no crossing */
    self.n = self.n + buf.len();
    Ok(buf.len())
  }
}

/* the fill, a byte written n times */
fn fills(w: *mut Writer, b: u8, n: usize) -> Result<(), Error> {
  let mut i: usize = 0;
  for i < n {
    w.write_u8(b)?;
    i = i + 1;
  }
  Ok(())
}

/* the pad: the value measured by a counting walk, the fill
 * written around it as the alignment asks -- the width a
 * minimum, a longer value left whole. The alignment the spec's
 * own, or the type's where the spec gives none: the numbers and
 * the pointers right, the rest left (the three languages' own
 * consensus, C++ and Rust and Python the same line). The asking
 * rides both walks, the counting no less -- the width measures
 * the cut value, and the digits the base spells */
fn pad<V: Fmt>(w: *mut Writer, v: *V, h: Hole) -> Result<(), Error> {
  w.prec = h.prec;
  w.base = h.base;
  if h.width == 0 {
    v.fmt(w)?;
    w.prec = 0;
    w.base = 0;
    Ok(())
  } else {
    let mut c = Count { n: 0 };
    let mut cw = Writer { w: &mut dyn c, prec: h.prec, base: h.base };

    v.fmt(&mut cw)?;
    let len = cw.written()?;
    let padn = if h.width > len { h.width - len } else { 0 };
    let align = if h.align != 0 {
      h.align
    } else {
      match @typeinfo<V>() {
        TypeInfo::Int { .. } => 62, /* '>' */
        TypeInfo::Float { .. } => 62,
        TypeInfo::Pointer { .. } => 62,
        _ => 60, /* '<' */
      }
    };

    if align == 60 { /* '<' -- the value first, the fill behind */
      v.fmt(w)?;
      fills(w, h.fill, padn)?;
    } else if align == 62 { /* '>' -- the fill first, the value after */
      fills(w, h.fill, padn)?;
      v.fmt(w)?;
    } else { /* '^' -- half before, half behind, the odd byte behind */
      let before = padn / 2;
      fills(w, h.fill, before)?;
      v.fmt(w)?;
      fills(w, h.fill, padn - before)?;
    }
    w.prec = 0;
    w.base = 0;
    Ok(())
  }
}

/* the peel: one unfolding a value -- the run before its hole,
 * the hole's spec read, the value padded through it, the rest on
 * -- the last the tail after the final hole, no value left. The
 * depth is the pack's own (04-generics.md) */
fn runs<...T: Fmt>(w: *mut Writer, fmt: []u8, at: usize, args: ...T) -> Result<(), Error> {
  const if @count(...T) == 0 {
    lit(w, fmt, at)?;
    Ok(())
  } else {
    let next = lit(w, fmt, at)?;
    let h = spec(fmt, next);

    pad(w, &args[0], h)?;
    runs(w, fmt, h.end, ...args[1..])
  }
}

/* the print: the format's doors taken where the call is written,
 * the shape first, the count against the pack's rows second -- a
 * call that fails either is refused before any program runs. The
 * walk itself is runtime, one door held the whole way, the count
 * the whole print's (12-projects.md) */
pub fn print<...T: Fmt>(const fmt: []u8, args: ...T) -> Result<usize, Error> {
  const if !shaped(fmt) {
    @compileError("a hole is {}, a brace is {{, a spec is {:...}: the format spells none of these")
  } else {
    const if holes(fmt) != @count(...T) {
      @compileError("the format asks a count of values the arguments do not give")
    } else {
      let mut out = Stdout { };
      let mut wr = Writer { w: &mut dyn out, prec: 0, base: 0 };

      runs(&mut wr, fmt, 0, ...args)?;
      wr.written()
    }
  }
}

/* the eprint: the same two doors, the same walk, the stderr door */
pub fn eprint<...T: Fmt>(const fmt: []u8, args: ...T) -> Result<usize, Error> {
  const if !shaped(fmt) {
    @compileError("a hole is {}, a brace is {{, a spec is {:...}: the format spells none of these")
  } else {
    const if holes(fmt) != @count(...T) {
      @compileError("the format asks a count of values the arguments do not give")
    } else {
      let mut out = Stderr { };
      let mut wr = Writer { w: &mut dyn out, prec: 0, base: 0 };

      runs(&mut wr, fmt, 0, ...args)?;
      wr.written()
    }
  }
}
