/* std::ops::Div -- `a / b` is Div::div(a, b), the operator's
 * sugar (07-operators.md): both operands enter by value, the
 * left one moving where its type is not Copy. The built-in rows
 * the spec promises are spelled here as source: a plain `n / m`
 * never comes to them, the checker's binop asked first. `Rhs`
 * defaults to Self (04-generics.md); the answer is the `Output`
 * associated type (05-traits.md), the rows here answering with
 * themselves. */

pub trait Div<Rhs = Self> {
  type Output;
  fn div(self: Self, other: Rhs) -> Self::Output;
}

impl Div for i8 { type Output = i8; fn div(self: Self, other: Self) -> Self::Output { self / other } }
impl Div for i16 { type Output = i16; fn div(self: Self, other: Self) -> Self::Output { self / other } }
impl Div for i32 { type Output = i32; fn div(self: Self, other: Self) -> Self::Output { self / other } }
impl Div for i64 { type Output = i64; fn div(self: Self, other: Self) -> Self::Output { self / other } }
impl Div for u8 { type Output = u8; fn div(self: Self, other: Self) -> Self::Output { self / other } }
impl Div for u16 { type Output = u16; fn div(self: Self, other: Self) -> Self::Output { self / other } }
impl Div for u32 { type Output = u32; fn div(self: Self, other: Self) -> Self::Output { self / other } }
impl Div for u64 { type Output = u64; fn div(self: Self, other: Self) -> Self::Output { self / other } }
impl Div for f32 { type Output = f32; fn div(self: Self, other: Self) -> Self::Output { self / other } }
impl Div for f64 { type Output = f64; fn div(self: Self, other: Self) -> Self::Output { self / other } }

/* std::ops::DivAssign -- `a /= b` is DivAssign::div_assign(&mut
 * a, b) (07-operators.md): the compound is its own trait, the
 * left borrowed for the write, the right a value the parameter's
 * slot takes whole. */

pub trait DivAssign<Rhs = Self> {
  fn div_assign(self: *mut Self, other: Rhs);
}

impl DivAssign for i8 { fn div_assign(self: *mut Self, other: Self) { *self = *self / other; } }
impl DivAssign for i16 { fn div_assign(self: *mut Self, other: Self) { *self = *self / other; } }
impl DivAssign for i32 { fn div_assign(self: *mut Self, other: Self) { *self = *self / other; } }
impl DivAssign for i64 { fn div_assign(self: *mut Self, other: Self) { *self = *self / other; } }
impl DivAssign for u8 { fn div_assign(self: *mut Self, other: Self) { *self = *self / other; } }
impl DivAssign for u16 { fn div_assign(self: *mut Self, other: Self) { *self = *self / other; } }
impl DivAssign for u32 { fn div_assign(self: *mut Self, other: Self) { *self = *self / other; } }
impl DivAssign for u64 { fn div_assign(self: *mut Self, other: Self) { *self = *self / other; } }
impl DivAssign for f32 { fn div_assign(self: *mut Self, other: Self) { *self = *self / other; } }
impl DivAssign for f64 { fn div_assign(self: *mut Self, other: Self) { *self = *self / other; } }
