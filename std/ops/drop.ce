/* std::ops::Drop -- the destructor trait (03-move.md): the one fn
 * every owning type declares, run when the value goes out of scope.
 * The exclusion pair's other half (04-generics.md): a type that
 * impls Drop does not impl Copy. Beside Copy in the operator
 * family -- the compiler's own call, at a scope's end -- and out of
 * the prelude with it (12-projects.md). */

pub trait Drop {
  fn drop(mut self: Self) -> ();
}
