/* std::ops::Eq -- `a == b` is Eq::eq(a, b), `a != b` its
 * negation, the operator's sugar (07-operators.md): both
 * operands enter by value, the left one moving where its type is
 * not Copy. The answer is a bool, not an Output -- a comparison
 * decides, it does not produce (07-operators.md). The built-in
 * rows the spec promises are spelled here as source: a plain
 * `n == m` never comes to them, the checker's binop asked first,
 * and what they hold is the spelled call, and every side the
 * built-in table does not take. The floats stay out: a NaN
 * equals nothing, itself included, so the law Eq assumes does
 * not hold over them, the calls refused, the operators answering
 * as the language always did. The borrowed rows below
 * name Copy: the marker beside them in std::ops now, a bare
 * name away (12-projects.md). */


pub trait Eq {
  fn eq(self: Self, other: Self) -> bool;
}

impl Eq for i8 { fn eq(self: Self, other: Self) -> bool { self == other } }
impl Eq for i16 { fn eq(self: Self, other: Self) -> bool { self == other } }
impl Eq for i32 { fn eq(self: Self, other: Self) -> bool { self == other } }
impl Eq for i64 { fn eq(self: Self, other: Self) -> bool { self == other } }
impl Eq for u8 { fn eq(self: Self, other: Self) -> bool { self == other } }
impl Eq for u16 { fn eq(self: Self, other: Self) -> bool { self == other } }
impl Eq for u32 { fn eq(self: Self, other: Self) -> bool { self == other } }
impl Eq for u64 { fn eq(self: Self, other: Self) -> bool { self == other } }
impl Eq for bool { fn eq(self: Self, other: Self) -> bool { self == other } }

/* the borrowed rows: `&a == &b` asks the same Eq of the pointers,
 * the Copy reads out of both and handed on. One generic row
 * covers every Copy element -- where another language writes a
 * macro over its matrix (14-macros.md), Cerium writes this. A
 * type that is not Copy borrows no row: moving out of a shared
 * borrow is not a thing to write, its own impl spells its fields
 * (07-operators.md). */

impl<T: Eq + Copy> Eq for *T {
  fn eq(self: *T, other: *T) -> bool { Eq::eq(*self, *other) }
}
