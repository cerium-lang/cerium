/* std::ops::BitOr -- `a | b` is BitOr::bitor(a, b), the
 * operator's sugar (07-operators.md): both operands enter by
 * value, the left one moving where its type is not Copy. The
 * built-in rows the spec promises are spelled here as source: a
 * plain `n | m` never comes to them, the checker's binop asked
 * first. `Rhs` defaults to Self (04-generics.md); the answer is
 * the `Output` associated type (05-traits.md), the rows here
 * answering with themselves. The integers are the domain, and
 * `bool` beside them: a pair the language never took, its union
 * a bool's own idea, the row here the spelling
 * (07-operators.md). No `BitOrAssign`: the language carries no
 * `|=` to sugar it, and a trait without its operator is a trait
 * nobody calls (07-operators.md). The borrowed rows below name
 * Copy: a library does not read its own face (12-projects.md),
 * so the marker arrives by use, the file's own binding. */

use std::Copy;

pub trait BitOr<Rhs = Self> {
  type Output;
  fn bitor(self: Self, other: Rhs) -> Self::Output;
}

impl BitOr for i8 { type Output = i8; fn bitor(self: Self, other: Self) -> Self::Output { self | other } }
impl BitOr for i16 { type Output = i16; fn bitor(self: Self, other: Self) -> Self::Output { self | other } }
impl BitOr for i32 { type Output = i32; fn bitor(self: Self, other: Self) -> Self::Output { self | other } }
impl BitOr for i64 { type Output = i64; fn bitor(self: Self, other: Self) -> Self::Output { self | other } }
impl BitOr for u8 { type Output = u8; fn bitor(self: Self, other: Self) -> Self::Output { self | other } }
impl BitOr for u16 { type Output = u16; fn bitor(self: Self, other: Self) -> Self::Output { self | other } }
impl BitOr for u32 { type Output = u32; fn bitor(self: Self, other: Self) -> Self::Output { self | other } }
impl BitOr for u64 { type Output = u64; fn bitor(self: Self, other: Self) -> Self::Output { self | other } }
impl BitOr for bool { type Output = bool; fn bitor(self: Self, other: Self) -> Self::Output { self | other } }

/* the borrowed rows: `&a | &b` asks the same BitOr of the
 * pointers, the Copy reads out of both and handed on. One
 * generic row covers every Copy element -- where another
 * language writes a macro over its matrix (14-macros.md),
 * Cerium writes this. A type that is not Copy borrows no row:
 * moving out of a shared borrow is not a thing to write, its
 * own impl spells its fields (07-operators.md). */

impl<T: BitOr + Copy> BitOr for *T {
  type Output = T::Output;
  fn bitor(self: *T, other: *T) -> T::Output { BitOr::bitor(*self, *other) }
}
