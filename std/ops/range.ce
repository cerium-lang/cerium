/* std::ops::Range -- the interval the loop was made for
 * (10-iteration.md): two ends, half-open, the value a struct both
 * ends live in. a..b builds one for the ends' own type -- the
 * checker's own sugar, any type that answers Ord and Step, not the
 * integers alone -- and this file is what it lands in.
 *
 * One generic row, not one a width: the order is Ord's own (a
 * borrowed read, the place untouched, 07-operators.md), the step
 * is Step's own (the value out and the cursor on, one call), and
 * the two bounds together are all a range asks of its ends. No
 * Copy rides the row -- Ord reads without moving, Step moves
 * without copying, and nothing else touches an end. The fields are
 * mut for the advance's write: a *mut does not lend what the field
 * never had (01-types.md). */

use std::iter::Iter;

pub struct Range<T> {
  mut start: T,
  mut end: T,
}

impl<T: Ord + Step> Iter for Range<T> {
  type Item = T;
  fn next(self: *mut Self) -> ?T {
    if self.start < self.end {
      Some(Step::advance(&mut self.start))
    } else {
      None
    }
  }
}

/* -- the tests (13-testing.md) ------------------------------- */

use std::debug::assert;

#[test("a 0..3 yields the three values, half-open")]
fn three_rounds() {
  let mut sum = 0;
  for i in 0..3 {
    sum = sum + i;
  }
  assert(sum == 3, "the rounds lost rows");   /* 0 + 1 + 2 */
}

#[test("a start at or past the end yields nothing")]
fn empty_interval() {
  let mut n = 0;
  for i in 3..3 {
    n = n + i;
  }
  assert(n == 0, "an empty interval ran");
}

/* a user's own type riding the same row: the ends need not be an
 * integer, only Ord and Step -- and Step's own move-out is @take,
 * the one sanctioned move (03-move.md), no Copy asked of the type */

struct Tick { mut n: i32 }
impl Ord for Tick { fn cmp(self: *Self, other: *Self) -> Ordering { Ord::cmp(&self.n, &other.n) } }
impl Step for Tick { fn advance(self: *mut Self) -> Self { let v = @take(self); self.n = v.n + 1; v } }

#[test("a user's own type rides the same row")]
fn users_own_ends() {
  let mut sum = 0;
  for t in (Tick { n: 10 }..Tick { n: 13 }) {
    sum = sum + t.n;
  }
  assert(sum == 33, "the ticks lost rounds");   /* 10 + 11 + 12 */
}
