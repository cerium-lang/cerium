/* std::ops::Range -- the interval the loop was made for
 * (10-iteration.md): two ends, half-open, the value a struct both

 * ends live in. a..b builds one for the ends' own integer type,
 * the checker's own sugar -- this file is what it lands in.
 *
 * The Iter rows are one an integer width, the builtin rows' own
 * shape (the Ord and Add files' precedent): the advance is a < and
 * a +1, both the checker's binop table takes for a concrete width,
 * and no bound a generic T could carry names the one a +1 needs --
 * the spec's own one-impl sketch does not compile, the rows the
 * answer. The fields are mut for the advance's write: a *mut does
 * not lend what the field never had (01-types.md). */

use std::iter::Iter;
pub struct Range<T> {
  mut start: T,
  mut end: T,
}

impl Iter for Range<i8> {
  type Item = i8;
  fn next(self: *mut Self) -> ?i8 {
    if self.start < self.end {
      let v = self.start;

      self.start = self.start + 1;
      return Some(v);
    }
    return None;
  }
}

