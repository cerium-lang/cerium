/* the pack: a variadic sum, two spellings of the same recursion --
 * the count's const if on one side, the peel and its overload on
 * the other -- the tuple spread on the call, its rows the pack's,
 * the empty pack no rows at all (04-generics.md) */
fn sum<...Ts>(ts: ...Ts) -> i64 {
  const if @count(...Ts) == 0 {
    0
  } else {
    @cast<i64>(ts[0]) + sum(...ts[1..])
  }
}

fn peel() -> i64 { /* the empty pack: the overload the peel lands on */
  0
}

fn peel<First, ...Rest>(first: First, rest: ...Rest) -> i64 {
  @cast<i64>(first) + peel(...rest)
}

fn main() -> i32 {
  let t: (i32, i32, i32) = (1, 2, 3); /* spread on the call: its rows
                                        * the pack's own */
  @cast<i32>(sum() + sum(1) + sum(1, 2) + sum(...t) + sum(1, 2, 3, 4) +
    peel() + peel(1) + peel(1, 2, 3) + peel(1, 2, 3, 4, 5))
}   /* 0 + 1 + 3 + 6 + 10 + 0 + 1 + 6 + 15 = 42 */
