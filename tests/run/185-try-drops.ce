/* the short circuit rides the return out: every binding the frame
 * owns runs its destructor on the way (03-move.md) -- the early exit
 * carrying its own, the landing one the closing brace's. */

use std::ops::Drop;


#[extern(C)]
fn write(fd: i32, buf: *u8, len: usize) -> usize;

struct D { n: i32 }

impl Drop for D {
  fn drop(mut self: Self) {
    let ds = "0123456789";

    write(1, ds.as_ptr() + @cast<usize>(self.n), 1);
  }
}

enum Error { No }

fn early(r: Error?i32) -> Error?i32 {
  let d = D { n: 7 };
  let v = r?; /* the Err road: d's destructor rides the return */
  Ok(v)       /* the Ok road: the closing brace runs it */
}

fn main() -> i32 {
  let a = match early(Err(Error::No)) {
    Ok(v)  => v,
    Err(e) => 99,
  };
  let b = match early(Ok(1)) {
    Ok(v)  => v,
    Err(e) => 98,
  };
  a + b
}
