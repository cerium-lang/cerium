/* the prelude, injected: Option, Result, Copy, Drop bound into
 * every user file without a use (12-projects.md) -- the injected
 * names yield to everything declared, everything a use brought in.
 * Some and None are std::Option's variants, not names in scope: a
 * bare Some rides the sugar's owner lookup (01-types.md). */

fn main() -> i32 {
  let x: Option<i32> = Some(3);
  let y: ()?i32 = Ok(4);
  let z = match x {
    Some(v) => v,
    None    => 0,
  };
  z + (match y {
    Ok(v)  => v,
    Err(_) => 0,
  })
}
