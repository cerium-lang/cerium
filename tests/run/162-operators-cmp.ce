/* the ordering and equality operators as trait calls
 * (07-operators.md): a < b is Ord::cmp(&a, &b) read against
 * Ordering::Less, a == b is Eq::eq(&a, &b), and a != b is its
 * negation -- both operands entering as borrows, a comparison
 * reading what it stands beside. Seven answers, one bit each, and
 * V3 no Copy: nothing above moves it. */
use std::ops::{Ord, Eq, Ordering};
struct V3 { x: i32, y: i32 }

impl Ord for V3 {
  fn cmp(self: *Self, other: *Self) -> Ordering {
    if self.x < other.x { return Ordering::Less; }
    if self.x > other.x { return Ordering::Greater; }
    if self.y < other.y { return Ordering::Less; }
    if self.y > other.y { return Ordering::Greater; }
    Ordering::Equal
  }
}
impl Eq for V3 {
  fn eq(self: *Self, other: *Self) -> bool { self.x == other.x && self.y == other.y }
}
fn main() -> i32 {
  let a = V3{ x: 1, y: 2 };
  let b = V3{ x: 1, y: 3 };
  let c = V3{ x: 1, y: 2 };
  let mut r = 0;
  if a < b { r += 1; }
  if a <= b { r += 2; }
  if b > a { r += 4; }
  if b >= a { r += 8; }
  if a == c { r += 16; }
  if a != b { r += 32; }
  if !(a > b) { r += 64; }
  r
}
