/* if is an expression: value form, else-if chains, nesting */
fn main() -> i32 {
  let a = if 1 < 2 { 10 } else { 20 };
  let b = if 2 < 1 { 1 } else if 3 < 4 { 2 } else { 3 };
  let c = if false { 0 } else if false { 1 } else if true { 30 } else { 40 };
  let d = if a > 5 { if b > 1 { 4 } else { 5 } } else { 6 };
  a + b + c + d    /* 10 + 2 + 30 + 4 = 46 */
}
