/* FCOND: while the condition holds; break and continue land past the step */
fn main() -> i32 {
  let mut i = 0;
  let mut sum = 0;
  for i < 10 {
    i = i + 1;
    if i % 2 == 0 { continue; }
    if i > 7 { break; }
    sum = sum + i;
  }
  sum * 10 + i    /* odds 1,3,5,7, break at 9: 16*10 + 9 = 169 */
}
