/* the ending a program may answer itself: exit, pub in std's root
 * (entry.ce), the Ok half a clean zero, the Err half one with the
 * value eprinted through its own words and the newline after it --
 * the same door run_err uses, a hand reaching it no less welcome
 * for being the program's own (12-projects.md) */

use std::fmt::{Fmt, Writer};
use std::io::Error;
use std::Result;
use std::exit;

struct Done { n: i64 }

impl Fmt for Done {
  fn fmt(self: *Self, w: *mut Writer) -> Result<(), Error> {
    w.write_str("done ")?;
    w.write_i64(self.n)
  }
}

fn main() -> i32 {
  let ok: Result<(), Done> = Ok(());
  let bad: Result<(), Done> = Err(Done { n: 7 });
  let a = exit(ok);
  let b = exit(bad);
  a + b + 40
}
