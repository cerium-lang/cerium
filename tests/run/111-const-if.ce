/* the const if: the condition must be compile-time known, and the
 * branch is picked at the walk -- the taken block the
 * conditional's own, the untaken discarded before checking, so it
 * may hold code that only compiles for some instantiations
 * (04-generics.md) */

use std::ops::Copy;

static mut S: u32 = 0;

/* the generic's own length decides: the declaration defers, each
 * instance its own branch */
fn mid<T: Copy, const N: usize>(v: [N]T) -> u32 {
  const if N > 2 { v[2] } else { v[0] }
}

/* the statement form: no else, the untaken side nothing at all */
fn bump<const N: usize>(v: [N]u32) -> u32 {
  const if N > 2 { S = S + 10; };
  v[0]
}

/* the chain: else const if, a const parameter's number picking */
fn band(const n: u32) -> u32 {
  const if n > 8 { 3 } else const if n > 2 { 2 } else { 1 }
}

/* the mixed chain: the untaken side a runtime if, running as itself */
fn mix<const N: usize>(v: [N]u32) -> u32 {
  const if N > 4 { v[0] } else { if v[1] > 5 { 90 } else { 9 } }
}

/* a compile-time call runs the branch the evaluator picks */
fn ev(const n: u32) -> u32 {
  const if n > 1 { n } else { 7 }
}
const A: u32 = ev(5);
const B: u32 = ev(0);

/* the typed let names the shape the deferred branch answers to:
 * the black box takes it as its placeholder (08-reflection.md) */
fn pick<const N: usize>(v: [N]u32) -> u32 {
  let x: u32 = const if N > 2 { v[2] } else { v[0] };
  x + 1
}

fn main() -> u32 {
  let a = [3]u32{7, 8, 9};
  let b = [1]u32{5};
  mid(a) + mid(b) * 2 + bump(a) + S * 2 + band(9) + band(3) * 10 + band(0)
    + mix([5]u32{1, 9, 9, 9, 9}) + mix([3]u32{1, 2, 3}) + A + B * 2 + pick(a)
    + @cast<u32>(const if @sizeof<u32>() > 2 { 1 } else { 0 })
}   /* 9 + 10 + 7 + 20 + 3 + 20 + 1 + 1 + 9 + 5 + 14 + 10 + 1 = 110 */
