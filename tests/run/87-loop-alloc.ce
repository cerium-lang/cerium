/* a loop's bindings share the fn's frame: every ask for stack goes
 * out at the entry, once -- the rounds of a long loop reuse the
 * slots they were given, or the frame walks itself off the guard
 * page, a round at a time (the emitter's entry discipline) */
fn main() -> i32 {
  let mut t: u32 = 0;
  let mut i: u32 = 0;
  for i < 500000 {           /* a fresh binding each round */
    let x = i;
    t = t + x % 2;
    i = i + 1;
  }
  let mut u: u32 = 0;
  let mut j: u32 = 0;
  for j < 300000 {           /* a value made, a pattern's slot, a round each */
    let mut o = Some(j);
    for let Some(y) = o {
      o = None;
      u = y % 3;
    }
    j = j + 1;
  }
  let mut q: u32 = 0;
  let mut k: u32 = 0;
  for k < 200000 {           /* a value merged across the branches */
    let z: u32 = if k % 2 == 0 { 1 } else { 2 };
    q = q + z;
    k = k + 1;
  }
  let a = [3]u32{7, 8, 9};   /* the iteration's own slots */
  let mut s: u32 = 0;
  for v in a {
    let w = v;
    s = s + w;
  }
  @cast<i32>(t % 100 + u + s + q % 10)  /* 0 + 0 + 12 + 0 */
}
