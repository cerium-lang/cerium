/* the right operand by value (07-operators.md): `v + V3{..}` and
 * `make() + make()` pass themselves -- the parameter's own slot
 * takes the value whole, no address taken, nothing borrowed, the
 * materialisation the operator once needed gone from its path.
 * The hand-written `&` of a temporary keeps it (01-types.md): a
 * value with no place of its own -- a sum, a nesting -- is
 * materialised, a nameless slot the statement's own block holds,
 * its address the answer. */
use std::ops::Add;

struct V3 { x: i32, y: i32 }

impl Add for V3 {
  type Output = V3;
  fn add(self: V3, other: V3) -> V3 { V3{ x: self.x + other.x, y: self.y + other.y } }
}

fn make() -> V3 { V3{ x: 10, y: 20 } }

fn main() -> i32 {
  let v = V3{ x: 1, y: 2 };
  let a = v + V3{ x: 5, y: 5 };         /* a literal operand, straight into the slot */
  let b = make() + make();              /* two call answers */
  let mut r = a.x + a.y + b.x + b.y;    /* 13 + 60 */
  let x = 3;
  let y = 4;
  let p = &(y - 1);                     /* the hand-written form: materialised */
  if *p == x { r += 1; }               /* 3 == 3 */
  let q = &(&3);                        /* the nesting */
  r += **q;                             /* 3 */
  let mut i = 0;
  for i < 3 {
    let t = &(i + 1);                   /* the round reuses its slot */
    r += *t;
    i += 1;
  }
  r                                     /* 73 + 1 + 3 + 6 = 83 */
}
