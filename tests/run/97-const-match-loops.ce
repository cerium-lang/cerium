/* the match, the destructuring let, the three for heads -- unwound
 * in the compiler, the same answers the runs below would give
 * (08-reflection.md, 09-match.md, 10-iteration.md) */
enum Op(u8) { Add(i32, i32), Neg(i32), Zilch }
enum E(u8) { A, B, C }
enum P(u8) { Pt { x: i32, y: i32 } }
struct Q { x: i32, y: i32 }

fn apply(o: Op) -> i32 {
  match o {
    Op::Add(a, b) => a + b,
    Op::Neg(a) => 0 - a,
    Op::Zilch => 0,
  }
}

fn pick(e: E) -> i32 {
  match e {
    A => 1,
    B | C => 2,
    _ => 3,
  }
}

fn named(p: P) -> i32 {
  match p {
    P::Pt { x: a, y: b } => a * 10 + b,
  }
}

fn blocky(e: E) -> i32 {
  match e {
    A => {
      let t = 10;
      t + 1
    },
    _ => 0,
  }
}

fn opt(o: ?i32) -> i32 {
  let m = match o {
    Some(v) => v,
    None => 0,
  };
  let mut n = 0;
  for v in o {
    n = n + v;
  }
  m + n
}

fn destr(t: (i32, i32), q: Q) -> i32 {
  let (a, b) = t;
  let { x, y } = q;
  a + b + x + y
}

fn take(i: i32) -> ?i32 {
  if i < 3 {
    Some(i + 1)
  } else {
    None
  }
}

fn counted() -> i32 {
  let mut i = 0;
  let mut s = 0;
  for let Some(v) = take(i) {
    s = s + v;
    i = i + 1;
  }
  s
}

fn loopy(a: [5]i32, t: i32) -> i32 {
  let mut n = 0;
  for x in a {
    if x == 0 {
      continue;
    };
    if x > t {
      break;
    };
    n = n + x;
  }
  let mut i = 0;
  for i < 3 {
    let mut j = 0;
    for j < i {
      if j == 1 {
        break;
      };
      n = n + 1;
      j = j + 1;
    }
    n = n + 10;
    i = i + 1;
  }
  n
}

fn early() -> i32 {
  let mut n = 0;
  for Some(v) in [3]?i32 { Some(1), None, Some(3) } {
    n = n + v;
  }
  n
}

const W: i32 = match Op::Zilch { /* the arms at a const's own initializer */
  Op::Add(a, b) => a + b,
  Op::Neg(a) => 0 - a,
  Op::Zilch => 7,
};

const S: i32 = apply(Op::Add(3, 4)) + apply(Op::Neg(5)) + apply(Op::Zilch) +
  pick(E::A) + pick(E::B) + pick(E::C) + named(P::Pt { x: 4, y: 5 }) + blocky(E::A) +
  opt(Some(5)) + opt(None) + destr((1, 2), Q { x: 3, y: 4 }) + counted() +
  loopy([5]i32 { 1, 0, 2, 200, 3 }, 100) + early() + W;

fn main() -> i32 { S }
