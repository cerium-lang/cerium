/* const evaluation, the arrays: a literal's elements, the zero fill
 * behind them, the indexes that read them -- the spec's own opening
 * example -- the nesting, the chain inside a literal, the mut that
 * is the slot's, and the calls that carry one across a frame. The
 * signed steps work through the negatives now too: the domain asks
 * the type's question, not the u64's, and the division rounds the
 * way the running program's does (08-reflection.md) */
const A: [3]u32 = [3]u32{1, 2, 3};               /* the opening: 6 */
const Z: [5]i32 = [5]i32{1, 2, 3};               /* the fill: [1,2,3,0,0] */
const NEST: [2][2]i32 = [2][2]i32{[2]i32{1, 2}, [2]i32{3, 4}};
const CH: i32 = 40;
const C: [2]i32 = [2]i32{CH + 2, CH / 4};        /* the chain inside: [42, 10] */
const M: [3]mut i32 = [3]mut i32{5, 6, 7};       /* the mut is the slot's */
fn width() -> usize { 4 }
const W: [width()]i32 = [width()]i32{7, 8};       /* a call as the length */
fn sum3(a: [3]i32) -> i32 { a[0] + a[1] + a[2] } /* one crosses a frame */
fn pick(n: i32) -> [2]i32 {                      /* a branch of arrays */
  if n < 0 { [2]i32{0, 1} } else { [2]i32{1, 0} }
}
const NEG: i32 = 0 - 1 - 1;                      /* the negatives: -2 */
const PRD: i32 = -3 * 7;                         /* was an error: -21 */
const DIV: i32 = -7 / 2;                         /* was floor's -4: -3 */
const LIT: i64 = -9223372036854775807 - 1;       /* the least, spelled */
const TOTAL: i32 = @cast<i32>(A[0] + A[1] + A[2]) /* 6 */
  + Z[3] + Z[4] + Z[0]                            /* +0+0+1: 7 */
  + NEST[1][0] + NEST[0][1]                       /* +3+2: 12 */
  + C[0] + C[1]                                   /* +42+10: 64 */
  + M[0] + M[2]                                   /* +5+7: 76 */
  + W[0] + W[1] + W[2] + W[3]                     /* +7+8+0+0: 91 */
  + sum3([3]i32{4, 5, 6})                         /* +15: 106 */
  + pick(-5)[1] + pick(7)[0]                      /* +1+1: 108 */
  + NEG + PRD + DIV                               /* -2-21-3: 82 */
  + @cast<i32>(LIT >> 62);                        /* -2: 80 */
fn main() -> i32 {
  let mut n = 0;
  let a = [3]i32{10, 20, 30};                     /* a runtime array */
  for x in a { n = n + x; }                       /* a runtime loop: 60 */
  n + TOTAL                                        /* 140 */
}
