/* the exact impl over the pack one: the specialization's order
 * holds mid-recursion too -- the sub-tuple the peel lands on found
 * by the exact table before the pack pattern sees it
 * (04-generics.md) */
trait Show { fn show(v: Self) -> i32; }

impl Show for i32 { fn show(v: Self) -> i32 { v } }
impl Show for (i32, i32) { fn show(v: Self) -> i32 { 100 } }

impl<...Ts: Show> Show for (...Ts) {
  fn show(v: Self) -> i32 {
    const if @count(...Ts) == 0 {
      0
    } else {
      Show::show(v[0]) + Show::show(v[1..])
    }
  }
}

fn main() -> i32 { Show::show((1, 2, 3)) + Show::show(()) + Show::show((4, 5)) }
/* (1,2,3) peels to 1 + (2,3), the exact table answering (2,3):
 * 1 + 100; the empty pack 0; (4,5) exact again: 101 + 0 + 100 = 201 */
