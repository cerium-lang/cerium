/* the const generic parameter: a value the angle brackets spell
 * and a length names -- fn first<T, const N: usize>(v: [N]T). The
 * call's own argument type binds it ([3]u32 names N = 3), each
 * length its own instantiation, and the body's reads of it fold
 * where they stand under the binding -- v[N-1] the re-check's own,
 * @sizeof<[N]T> its number, a pass through another generic's length
 * the black box the outer binding answers (08-reflection.md) */

use std::ops::Copy;

fn first<T: Copy, const N: usize>(v: [N]T) -> T { v[0] }
fn last<T: Copy, const N: usize>(v: [N]T) -> T { v[N-1] }
fn sz<T, const N: usize>(v: [N]T) -> usize { @sizeof<[N]T>() }
fn wrap<T: Copy, const N: usize>(v: [N]T) -> T { first(v) }
fn dup<T: Copy, const N: usize>(v: [N]T) -> [N]T { v }

fn main() -> u32 {
  let a = [3]u32{7, 8, 9};
  let b = [4]u32{1, 2, 3, 4};
  first(a)                  /* 7: N = 3 from the argument's own type */
    + last(a) * 10          /* 90: N folds, v[N-1] the re-check's own */
    + last(b)               /* 4: its own instance, N = 4 */
    + @cast<u32>(sz(a)) * 2 /* 24: [3]u32 folded where it stands */
    + @cast<u32>(sz([4]u64{1, 2, 3, 4})) /* 32: the [4]u64 instance */
    + wrap(a)               /* 7: the black-box pass, bound in the re-check */
    + dup(a)[1]             /* 8: [N]T through and back */
}
