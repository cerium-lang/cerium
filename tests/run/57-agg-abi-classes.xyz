/* structs by value through calls, at every ABI class, plus a nested one:
 * 8B lands in one register, 16B in two, 24B goes by memory -- and the
 * nested Out makes the emitter register Inner before anyone names it */
struct P { x: i32, y: i32 }
struct Q { a: i64, b: i64 }
struct R { v1: i32, v2: i32, v3: i32, v4: i32, v5: i32, v6: i32 }
struct In { a: i32, b: i32 }
struct Out { i: In, z: i64 }
fn addp(a: P, b: P) -> P { P { x: a.x + b.x, y: a.y + b.y } }
fn addq(a: Q, b: Q) -> Q { Q { a: a.a + b.a, b: a.b + b.b } }
fn addr(a: R, b: R) -> R {
  R { v1: a.v1 + b.v1, v2: a.v2 + b.v2, v3: a.v3 + b.v3,
      v4: a.v4 + b.v4, v5: a.v5 + b.v5, v6: a.v6 + b.v6 }
}
fn bump(o: Out) -> Out { Out { i: In { a: o.i.a + 1, b: o.i.b + 1 }, z: o.z + 1 } }
fn main() -> i32 {
  let p = addp(P { x: 1, y: 2 }, P { x: 10, y: 20 });      /* 11, 22 */
  let q = addq(Q { a: 1, b: 2 }, Q { a: 10, b: 20 });      /* 11, 22 */
  let r = addr(R { v1: 1, v2: 1, v3: 1, v4: 1, v5: 1, v6: 1 },
               R { v1: 1, v2: 2, v3: 3, v4: 4, v5: 5, v6: 6 });  /* 2,3,4,5,6,7 */
  let w = bump(Out { i: In { a: 1, b: 2 }, z: 3 });        /* 2, 3, 4 */
  let s1 = @cast<i32>(q.a + q.b);                /* 33 */
  let s2 = p.x + p.y + r.v1 + r.v6;              /* 42 */
  let s3 = w.i.a + w.i.b + @cast<i32>(w.z);      /* 9 */
  s1 + s2 + s3 + r.v4                            /* 33 + 42 + 9 + 5 = 89 */
}
