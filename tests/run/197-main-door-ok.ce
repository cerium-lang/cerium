/* main's own door, the Ok half: the compiler's wrapper hands the
 * main to std::entry's run_err, the ending to fmt's exit there,
 * and the program answers a clean zero. The main prints first --
 * the door the ending leaves open -- and its Done carries its own
 * Fmt anyway, the bound the declaration itself is checked against,
 * Ok half or not. */

use std::fmt::{Error, Fmt, Writer, print_one}; /* the shapes' own error,
                                                * fmt's (fmt/error.ce) */
use std::Result;

struct Done { n: i64 }

impl Fmt for Done {
  fn fmt(self: *Self, w: *mut Writer) -> Result<(), Error> {
    w.write_str("done ")?;
    w.write_i64(self.n)
  }
}

fn main() -> Done?() {
  print_one(&("the ok half\n"));
  Ok(())
}
