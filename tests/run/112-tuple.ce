/* the tuple: whole and by row -- the value, the index, the pattern,
 * and the spread that spells its rows as arguments of their own
 * (01-types.md) */
use std::ops::Copy; /* the generic row's bound: the name the use
                     * itself is (12-projects.md) */

struct P { xy: (u32, u32), z: u32 }

fn pair() -> (u32, u32) { (3, 4) }              /* the return */

fn both(t: (u32, u32)) -> u32 { t.0 * 10 + t.1 } /* the parameter */

fn first2<T: Copy>(t: (T, T)) -> T { t.0 }      /* the generic row: a
                                                * row read moves the
                                                * row, so the Copy the
                                                * bound names is the
                                                * read's own ground
                                                * (03-move.md) */

fn add3(a: u32, b: u32, c: u32) -> u32 { a * 100 + b * 10 + c }

fn one() -> u32 { 1 }

const CT: (u32, u32) = (7, 8);                   /* the compile-time */
const CS: u32 = add3(9, ...CT) % 10;             /* ... and its spread */

fn main() -> i32 {
  let t: (u32, u32, u32) = (1, 2, 3);
  let (a, _, c) = t;                /* the pattern, _ skipping */
  let q = match pair() { (x, y) => x * 10 + y, };
  let m: (u32, mut u32) = (5, 6);   /* the writable row alone */
  m.1 = 60;
  let n: (u32, (u32, u32)) = (1, (2, 3));  /* the nesting */
  let sp = P{ xy: (1, 2), z: 3 };   /* a tuple in a field */
  let e: () = ();                   /* the unit: the empty tuple */
  @cast<i32>(a + c * 2 + q + m.1 / 10 + n.1.0 + n.1.1 * 2 + sp.xy.0 + sp.xy.1 * 2 + sp.z
    + both((9, 8)) / 10 + @cast<u32>(first2((7, 9)))
    + @cast<u32>(@sizeof<(u32, u64)>()) / 8 + CS + add3(...t) % 100
    + add3(4, ...CT) % 10 + add3(...(t.0, t.1, t.2)) % 10 + one(...e))
}   /* 1 + 6 + 34 + 6 + 2 + 6 + 1 + 4 + 3 + 9 + 7 + 2 + 8 + 23 + 8 + 3 + 1 = 124 */
