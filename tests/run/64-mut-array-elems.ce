/* [N]mut T: the elements are writable slots; reads strip the mut
 * layer, writes go through the same address -- and a compound
 * assignment reads and writes in one place */
fn main() -> i32 {
  let a = [2]mut i32{5, 6};
  a[1] += 5;
  a[0] = a[1];
  let i = 1;
  a[i] = a[i] + a[0];      /* a[1] = 11 + 11 = 22 */
  a[0] * 10 + a[1]         /* 110 + 22 = 132 */
}
