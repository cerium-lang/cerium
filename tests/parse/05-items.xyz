}

enum Void {}
enum Opt<T> { Some(T), None, }

trait Read {
  type Item;
  const BUF: usize;
  fn read(self: *mut Self) -> ?Item;
}

trait Eq<T> {
  fn eq(self: *Self, o: *T) -> bool;
}

trait Default {
  fn d() -> i32 { 0 }
}

impl Read for File {
  type Item = u8;
  const BUF: usize = 4;
  fn read(self: *mut Self) -> ?Item { None }
}

impl<T> Vec<T> {
  fn len(self: *Self) -> usize { 0 }
}

