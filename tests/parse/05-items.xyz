struct Point { x: f32, y: f32 }
struct Mut { mut a: i32 }
struct G<T> { v: T }
#[repr(C)]
struct Repr { a: u8 }
struct Empty {}
struct Trail { a: i32, b: i32, }
struct FieldAttr { #[a] x: i32, #[b, c] y: i32 }

union U { a: i32, b: f32 }

enum Shape {
  Unit,
  Circle(f32),
  Rect { w: f32, h: f32 },
