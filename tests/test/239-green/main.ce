/* the all-green artifact: a () beside a described one, and a
 * namespace's private beside an E?()'s Ok -- every shape the
 * runner walks, every one passing (13-testing.md) */

#[test]
fn one_is_one() {
  let x = 1;
  let y = 1;
  if x != y {
    panic("not equal");
  };
}

#[test("arithmetic, the small kind")]
fn two_plus_two() {
  let x = 2 + 2;
  if x != 4 {
    panic("wrong sum");
  };
}
