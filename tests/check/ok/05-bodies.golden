(file
  (struct Point
    (field x f64)
    (field mut y f64))
  (struct Keep
    (field mut f fn(i32) -> i32))
  (enum Shape
    (variant Circle = 0 (field r f64))
    (variant Rect = 1 f64 f64)
    (variant Unit = 2))
  (impl Point
    (fn new fn(f64) -> Point)
    (fn get fn(*Point) -> f64)
    (fn bump fn(*mut Point, f64))
    (fn rect fn(f64, f64) -> Shape))
  (fn id fn(i32) -> i32)
  (fn area fn(*Shape) -> f64)
  (fn narrowed fn(?i32, i32) -> i32)
  (fn getor fn(?i32, i32) -> i32)
  (fn sum fn([]i32) -> i32)
  (fn upto fn(i32) -> i32)
  (fn spin fn(fn() -> bool) -> i32)
  (fn nextish fn() -> ?i32)
  (fn find fn([]i32) -> ?i32)
  (fn borrow fn(*mut Point) -> f64)
  (fn takeout fn() -> i32)
  (fn sizes fn() -> usize)
  (fn early fn(*mut Point))
  (fn usekeep fn(Keep) -> i32)
  (fn earlytake fn(Keep, bool) -> i32)
  (fn slices fn([4]i32) -> i32)
  (fn tuples fn((i32, f64)) -> i32)
  (fn castit fn(i32) -> u32)
  (fn ortho fn(Point) -> f64)
  (fn main fn() -> i32))
