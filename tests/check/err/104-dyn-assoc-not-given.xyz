/* a handle whose trait declares an associated type must name it: a
 * vtable's signature has no projection left open (06-dispatch.md) */
trait Iterator {
  type Item;
  fn next(self: *mut Self) -> ?Self::Item;
}
struct Counter { mut n: u32, mut top: u32 }
impl Iterator for Counter {
  type Item = u32;
  fn next(self: *mut Self) -> ?u32 { None }
}
fn main() -> u32 {
  let mut c = Counter{ n: 0, top: 0 };
  let i: dyn mut Iterator = &mut dyn c; /* Item is not given */
  return 0;
}
