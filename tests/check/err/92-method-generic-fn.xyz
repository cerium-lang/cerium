/* a method's own parameters are its trait's, positionally: an impl
 * supplying more (or fewer) than the declaration names is a
 * different family (04-generics.md, 05-traits.md) */
trait Store {
  fn get<K>(self: *Self, k: *K) -> ?u32;
}
struct Map { mut v: u32 }
impl Store for Map {
  fn get<K, J>(self: *Self, k: *K) -> ?u32 { None }
}
fn main() -> u32 {
  return 0;
}
