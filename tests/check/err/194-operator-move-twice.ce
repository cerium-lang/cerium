/* a non-Copy operand enters by value, so it moves (07-operators.md):
 * the left one moves into the call, and the second read of the
 * same place finds it dead -- the words the trait's own
 * signature says, the same one a spelled call answers with */
use std::ops::Add;

struct W { n: i32 }

impl Drop for W { fn drop(mut self: Self) { } }

impl Add for W {
  type Output = W;
  fn add(self: W, other: W) -> W { W{ n: self.n + other.n } }
}

fn main() -> i32 {
  let v = W{ n: 1 };
  let a = v + v;      /* the left moves, the second read is dead */
  a.n
}
