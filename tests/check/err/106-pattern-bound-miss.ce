/* a pattern impl whose bound the receiver cannot answer: the impl
 * is not a fit, and with no other, no impl at all (04-generics.md) */

use std::ops::{Copy, Drop};

trait Show {
  fn show(self: *Self) -> u32;
}
struct File { fd: u32 }
impl Drop for File {
  fn drop(mut self: Self) -> () {}
}
impl<T: Copy> Show for T {
  fn show(self: *Self) -> u32 { 1 }
}
fn main() -> u32 {
  let f = File{ fd: 3 };
  return Show::show(&f); /* File has a destructor: not Copy */
}
