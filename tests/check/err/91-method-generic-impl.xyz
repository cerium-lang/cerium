/* a method of a generic impl: which impl a type's method comes from
 * is the specialization machinery's call, not the sugar's
 * (04-generics.md) */
struct Box<T> { mut v: T }
impl<T> Box<T> {
  fn get(self: *Box<T>) -> i32 { return 3; }
}
fn go(b: Box<i32>) -> i32 {
  b.get()
}
fn main() -> i32 { 0 }
