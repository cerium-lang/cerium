/* a tuple handed to a pack's parameter is the fold's one row, its
 * rows not unbound from it: the gather is the unifier's own, never
 * the call's -- spread with ... to walk the rows in
 * (04-generics.md) */
use std::iter::zip;

fn main() -> i32 {
  let t = ([]i32{1, 2}, []i32{3, 4});
  zip(t)   /* the tuple one row: a row that is no Iter, refused */
}
