/* &[N]T iterates only through an impl the const length names --
 * ArrayIter's own arrival, 08-reflection.md's. The pointer is not
 * a slice, and no IntoIter answers it until then (10-iteration.md) */
fn main() -> i32 {
  let a = [3]i32{1, 2, 3};
  let mut n = 0;

  for x in &a {
    n = n + *x;
  }
  n
}
