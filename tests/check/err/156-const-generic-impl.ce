/* a const generic parameter on an impl: the row it writes has a baked
 * number to hand over and nothing at the handle names one, so no
 * instance is ever picked and the handle has no row to point at.
 * The old refusal -- the whole shape arriving with a later milestone
 * -- is gone: const generics on impls landed (#164) */
trait T1 { fn f(self: *Self) -> u32; }

impl<const N: usize> T1 for u32 {
  fn f(self: *Self) -> u32 { N }
}

fn main() -> i32 {
  let x: u32 = 1;
  let h: dyn T1 = &dyn x;

  0
}
