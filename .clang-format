# xyz style: qbe-lineage C89.
#   return type on its own line, every definition's brace on its own
#   line — functions, structs, enums, unions alike, 2-space indent,
#   pointers bind right, macro bodies aligned.
Language: Cpp
BasedOnStyle: LLVM
ColumnLimit: 100
IndentWidth: 2
UseTab: Never

# functions: qbe shape — "void *\nname(args)\n{"
AlwaysBreakAfterReturnType: TopLevelDefinitions
BreakBeforeBraces: Custom
BraceWrapping:
  AfterFunction: true
  AfterControlStatement: Never
  AfterStruct: true
  AfterEnum: true
  AfterUnion: true
  AfterExternBlock: false
  IndentBraces: false
  SplitEmptyFunction: false
  SplitEmptyRecord: false

PointerAlignment: Right
SpaceAfterCStyleCast: true
AlignConsecutiveMacros:
  Enabled: true
  AcrossEmptyLines: false
  AcrossComments: false
AlignConsecutiveDeclarations:
  Enabled: true
  AcrossEmptyLines: false
  AcrossComments: false
AlignEscapedNewlines: Right
AlignTrailingComments: true

AllowShortIfStatementsOnASingleLine: false
AllowShortFunctionsOnASingleLine: None
AllowShortLoopsOnASingleLine: false
KeepEmptyLinesAtTheStartOfBlocks: false
IndentCaseLabels: false
SortIncludes: false
InsertBraces: false
